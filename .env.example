# RSVP por hogar integrado con la plataforma de bodas.
# Configurar las tres variables en el proyecto Vercel isra-liz,
# usando la URL y la clave PUBLISHABLE/ANON de Supabase (NUNCA service_role).
WEDDING_PLATFORM_SUPABASE_URL=
WEDDING_PLATFORM_SUPABASE_ANON_KEY=
# Slug exacto de la boda de Isra + Liz en /app del panel (no la URL del proyecto):
WEDDING_PLATFORM_WEDDING_SLUG=

# Legado: solo se usa en el formulario general mientras la integración no esté configurada.
# Con las tres variables anteriores completas, solo se reciben RSVP desde /i/[code].
RESEND_API_KEY=
RSVP_TO_EMAIL=lavidadeuncreativo@gmail.com
RSVP_FROM_EMAIL=Invitacion Isra&Liz <invitacion@tu-dominio.com>

# Ligas opcionales para activar mesas externas
NEXT_PUBLIC_PALACIO_GIFT_LINK=
NEXT_PUBLIC_AMAZON_GIFT_LINK=
